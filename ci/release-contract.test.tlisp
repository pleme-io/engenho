;; release-contract.test.tlisp — (deftest …) suite for ci/release-contract.tlisp.
;; Run by pleme-io/actions/tlisp-test (test.yml, job ci-contract-tests) as
;; stdlib + unit + this file with TLISP_TEST=1, from the repository root.
;;
;; The first tests read the real .github/workflows/release.yml and Cargo.toml,
;; so they fail when release.yml breaks the contract. The rest run the check
;; against a small fixture that keeps the contract, then against one mutation
;; per rule, so each rule is shown to fire on the defect it names.

(define (t:has? vs needle) (any? (fn (v) (string-contains? v needle)) vs))

(define (t:asset? assets kind name) (member? (list kind name) assets))

;; The fixture's workspace: package `tool` declares the binary `tool`.
(define t:BINS (list (list "tool" "tool")))

(define (t:vs wf) (rc:violations-in wf t:BINS))

(define t:GOOD "
on:
  push:
    tags: ['v*']
jobs:
  binary-tool:
    uses: pleme-io/substrate/.github/workflows/rust-binary-release.yml@main
    with:
      binary-name: tool
      package: tool
      artifact-only: true
    secrets: inherit
  image-tool-amd64:
    uses: pleme-io/substrate/.github/workflows/image-push.yml@main
    with:
      imageAttr: tool-image-amd64
      imageName: pleme-io/tool
      tag: ${{ github.ref_name }}-amd64
      additionalTags: ''
    secrets: inherit
  image-manifest:
    needs: [image-tool-amd64]
    runs-on: ubuntu-latest
    steps:
      - run: |
          docker buildx imagetools create \\
            --tag ghcr.io/pleme-io/tool:${{ github.ref_name }} \\
            ghcr.io/pleme-io/tool:${{ github.ref_name }}-amd64
  chart:
    uses: pleme-io/substrate/.github/workflows/helm-chart-release.yml@main
    with:
      chart-path: ./charts/engenho
      oci-registry: oci://ghcr.io/pleme-io/engenho/charts
    secrets: inherit
  release-assets:
    needs: [binary-tool, image-tool-amd64, image-manifest, chart]
    if: startsWith(github.ref, 'refs/tags/v')
    runs-on: ubuntu-24.04
    outputs:
      images: ${{ steps.verify.outputs.matrix }}
      files: ${{ steps.verify.outputs.files }}
    steps:
      - uses: actions/checkout@v4
      - name: fetch tool to check
        uses: actions/download-artifact@v4
        with:
          name: ${{ needs.binary-tool.outputs.artifact-name }}
          path: release-files
      - id: verify
        uses: pleme-io/actions/tatara-script@main
        with:
          script-file: ci/release-contract.tlisp
        env:
          RELEASE_CONTRACT_MODE: verify
          RELEASE_TAG: ${{ github.ref_name }}
  publish-release:
    needs: [release-assets, binary-tool]
    runs-on: ubuntu-24.04
    steps:
      - name: fetch tool to publish
        uses: actions/download-artifact@v4
        with:
          name: ${{ needs.binary-tool.outputs.artifact-name }}
          path: release-files
      - uses: pleme-io/actions/gh-release-create@main
        with:
          tag: ${{ github.ref_name }}
          assets: ${{ needs.release-assets.outputs.files }}
          if-exists: fail
  promote-latest:
    needs: [release-assets, publish-release]
    runs-on: ubuntu-24.04
    strategy:
      matrix:
        image: ${{ fromJSON(needs.release-assets.outputs.images) }}
    steps:
      - uses: pleme-io/actions/release-promote@main
        with:
          image: ${{ matrix.image }}
          source-tag: ${{ github.ref_name }}
          target-tag: latest
")

(define (t:wf text) (yaml-parse text))

;; The fixture with one substring replaced. It must occur exactly once, or the
;; mutation test would silently check the unmutated fixture, or mutate more
;; than the one place it names.
(define (t:mutant from to)
  (assert (= (length (string-split t:GOOD from)) 2) (string-append "fixture does not contain exactly once: " from))
  (t:wf (string-replace t:GOOD from to)))

(define t:ASSETS-DOWNLOAD "      - name: fetch tool to check
        uses: actions/download-artifact@v4
        with:
          name: ${{ needs.binary-tool.outputs.artifact-name }}
          path: release-files
")

(define t:PUBLISH-DOWNLOAD "      - name: fetch tool to publish
        uses: actions/download-artifact@v4
        with:
          name: ${{ needs.binary-tool.outputs.artifact-name }}
          path: release-files
")

(define t:CREATE "      - uses: pleme-io/actions/gh-release-create@main
        with:
          tag: ${{ github.ref_name }}
          assets: ${{ needs.release-assets.outputs.files }}
          if-exists: fail
")

(deftest "the real release.yml keeps the contract"
  (let ((vs (rc:violations (rc:load))))
    (for-each (fn (v) (print-line v)) vs)
    (assert (> (length (rc:job-names (rc:load))) 0) "release.yml was read and has jobs")
    (assert (= (length vs) 0) "no violation in .github/workflows/release.yml")))

(deftest "the real release.yml promises every leg's assets, and never :latest"
  (let* ((assets (rc:expected-assets (rc:load) "v1.2.3"))
         (files (filter (fn (a) (equal? (car a) "file")) assets)))
    (for-each
      (fn (bin)
        (for-each
          (fn (leg)
            (assert (t:asset? assets "file" (string-append bin "-" leg)) (string-append bin "-" leg))
            (assert (t:asset? assets "file" (string-append bin "-" leg ".sha256")) (string-append bin "-" leg ".sha256")))
          (list "linux-x86_64" "linux-aarch64" "macos-x86_64" "macos-aarch64")))
      (list "engenho-mcp" "engenho-cluster-config-render"))
    (assert (= (length files) 16) "2 binaries x 4 legs x (binary, .sha256)")
    (for-each
      (fn (bin)
        (assert (t:asset? assets "oci" (string-append "ghcr.io/pleme-io/" bin ":v1.2.3-amd64")) (string-append bin " amd64"))
        (assert (t:asset? assets "oci" (string-append "ghcr.io/pleme-io/" bin ":v1.2.3-arm64")) (string-append bin " arm64"))
        (assert (t:asset? assets "oci" (string-append "ghcr.io/pleme-io/" bin ":v1.2.3")) (string-append bin " multi-arch index")))
      (list "engenho-mcp" "engenho-cluster-config-render"))
    (assert (t:asset? assets "oci" "ghcr.io/pleme-io/engenho/charts/engenho:1.2.3") "chart at the tag's version, v stripped")
    (assert (not (any? (fn (a) (string-contains? (car (cdr a)) "latest")) assets)) "no asset is a latest tag")
    (assert (equal? (rc:image-repos (rc:load)) (list "ghcr.io/pleme-io/engenho-mcp" "ghcr.io/pleme-io/engenho-cluster-config-render"))
      "promote-latest moves both images")))

(deftest "the real release publishes the 16 checked files from release-files/, and only them"
  (let ((staged (rc:staged-files (rc:expected-assets (rc:load) "v1.2.3"))))
    (assert (= (length staged) 16) "16 staged paths: what release-assets checks is what publish-release uploads")
    (assert (not (any? (fn (p) (not (string-starts-with? p "release-files/"))) staged)) "every path is under the staging directory")
    (assert (member? "release-files/engenho-mcp-linux-aarch64" staged) "an aarch64 binary is in the published set")
    (assert (member? "release-files/engenho-cluster-config-render-macos-x86_64.sha256" staged) "a checksum file is in the published set")))

(deftest "each released binary is declared by the package of the same name"
  (let ((bins (rc:workspace-bins)))
    (assert (> (length bins) 2) "Cargo.toml's members were read")
    (assert (member? (list "engenho-mcp" "engenho-mcp") bins) "engenho-mcp declares engenho-mcp")
    (assert (member? (list "engenho-cluster-config-render" "engenho-cluster-config-render") bins)
      "engenho-cluster-config-render declares engenho-cluster-config-render")
    (assert (not (member? (list "engenho-mcp" "engenho-cluster-config-render") bins)) "a package is not credited with another's binary")))

(deftest "the fixture keeps the contract, and a runner label is not a latest tag"
  (let ((vs (t:vs (t:wf t:GOOD))))
    (for-each (fn (v) (print-line v)) vs)
    (assert (= (length vs) 0) "clean fixture has no violation, though it says ubuntu-latest")))

(deftest "a binary job in the default mode would publish each leg before the gate"
  (let ((vs (t:vs (t:mutant "      artifact-only: true\n" ""))))
    (assert (t:has? vs "job `binary-tool`: rust-binary-release.yml needs `artifact-only: true`") "omitted: default mode refused"))
  (let ((vs (t:vs (t:mutant "artifact-only: true" "artifact-only: false"))))
    (assert (t:has? vs "job `binary-tool`: rust-binary-release.yml needs `artifact-only: true`") "false refused"))
  (let ((vs (t:vs (t:mutant "artifact-only: true" "artifact-only: ${{ inputs.dry }}"))))
    (assert (t:has? vs "job `binary-tool`: rust-binary-release.yml needs `artifact-only: true`") "an expression cannot be proven true")))

(deftest "a binary job must name the package that declares its binary"
  (let ((vs (t:vs (t:mutant "      package: tool\n" ""))))
    (assert (t:has? vs "job `binary-tool`: rust-binary-release.yml needs `package:`") "no package: features unify across the workspace"))
  (let ((vs (t:vs (t:mutant "package: tool" "package: other"))))
    (assert (t:has? vs "job `binary-tool`: package `other` is not a workspace member that declares the binary `tool`")
      "a package that does not declare the binary is refused")))

(deftest "only publish-release writes a GitHub Release"
  (let ((vs (t:vs (t:mutant "      - run: |\n          docker buildx"
                            "      - uses: softprops/action-gh-release@v2\n      - run: |\n          docker buildx"))))
    (assert (t:has? vs "job `image-manifest`: writes a GitHub Release") "a softprops step outside publish-release"))
  (let ((vs (t:vs (t:mutant "      - uses: actions/checkout@v4\n"
                            "      - uses: actions/checkout@v4\n      - run: gh release upload v1 x\n"))))
    (assert (t:has? vs "job `release-assets`: writes a GitHub Release") "a gh release upload in the gate")))

(deftest "publish-release must exist and wait for release-assets"
  (let ((vs (t:vs (t:mutant "  publish-release:\n" "  publish-release-renamed:\n"))))
    (assert (t:has? vs "job `publish-release`: missing") "missing publisher named")
    (assert (t:has? vs "job `publish-release-renamed`: writes a GitHub Release") "and the renamed writer is refused"))
  (let ((vs (t:vs (t:mutant "    needs: [release-assets, binary-tool]\n" "    needs: [binary-tool]\n"))))
    (assert (t:has? vs "job `publish-release`: does not need `release-assets`") "the release waits for the check")))

(deftest "publish-release uploads exactly the checked files and refuses an existing release"
  (let ((vs (t:vs (t:mutant "assets: ${{ needs.release-assets.outputs.files }}" "assets: release-files/tool-linux-x86_64"))))
    (assert (t:has? vs "job `publish-release`: gh-release-create needs `assets: ${{ needs.release-assets.outputs.files }}`")
      "a hand-written file list is refused"))
  (let ((vs (t:vs (t:mutant "if-exists: fail" "if-exists: skip"))))
    (assert (t:has? vs "job `publish-release`: gh-release-create needs `if-exists: fail`") "skip refused"))
  (let ((vs (t:vs (t:mutant "          if-exists: fail\n" ""))))
    (assert (t:has? vs "job `publish-release`: gh-release-create needs `if-exists: fail`") "the default (skip) refused"))
  (let ((vs (t:vs (t:mutant t:CREATE ""))))
    (assert (t:has? vs "job `publish-release`: needs a step using pleme-io/actions/gh-release-create@") "no create step refused")))

(deftest "both gate jobs download every binary's artifact before reading the files"
  (let ((vs (t:vs (t:mutant t:ASSETS-DOWNLOAD ""))))
    (assert (t:has? vs "job `release-assets`: does not download `${{ needs.binary-tool.outputs.artifact-name }}` into release-files/")
      "the check would see no binary"))
  (let ((vs (t:vs (t:mutant t:PUBLISH-DOWNLOAD ""))))
    (assert (t:has? vs "job `publish-release`: does not download `${{ needs.binary-tool.outputs.artifact-name }}` into release-files/")
      "the upload would find no file"))
  (let ((vs (t:vs (t:mutant (string-append t:PUBLISH-DOWNLOAD t:CREATE) (string-append t:CREATE t:PUBLISH-DOWNLOAD)))))
    (assert (t:has? vs "job `publish-release`: does not download `${{ needs.binary-tool.outputs.artifact-name }}` into release-files/ before gh-release-create")
      "a download after the upload is refused"))
  (let ((vs (t:vs (t:mutant "          name: ${{ needs.binary-tool.outputs.artifact-name }}\n          path: release-files\n      - uses: pleme-io/actions/gh"
                            "          name: ${{ needs.binary-tool.outputs.artifact-name }}\n          path: elsewhere\n      - uses: pleme-io/actions/gh"))))
    (assert (t:has? vs "job `publish-release`: does not download") "a download to another directory is refused"))
  (let ((vs (t:vs (t:mutant "    needs: [release-assets, binary-tool]\n" "    needs: [release-assets]\n"))))
    (assert (t:has? vs "job `publish-release`: does not need `binary-tool`") "the artifact name is only readable from a direct need")))

(deftest "release-assets outputs the files it checked"
  (let ((vs (t:vs (t:mutant "      files: ${{ steps.verify.outputs.files }}\n" ""))))
    (assert (t:has? vs "job `release-assets`: needs `outputs: files: ${{ steps.verify.outputs.files }}`") "files output required")))

(deftest "an image-push call without additionalTags pushes latest by default"
  (let ((vs (t:vs (t:mutant "      additionalTags: ''\n" ""))))
    (assert (t:has? vs "job `image-tool-amd64`") "names the image job")
    (assert (t:has? vs "additionalTags") "says which input")))

(deftest "an image-push call with no tag pushes latest by default"
  (let ((vs (t:vs (t:mutant "      tag: ${{ github.ref_name }}-amd64\n" ""))))
    (assert (t:has? vs "job `image-tool-amd64`: image-push.yml needs `tag:`") "tag must be declared")))

(deftest "an additional latest tag on an arch leg is refused"
  (let ((vs (t:vs (t:mutant "additionalTags: ''" "additionalTags: latest"))))
    (assert (t:has? vs "job `image-tool-amd64`: names the `latest` tag") "latest named outside promote-latest")))

(deftest "the manifest job may not tag the index latest"
  (let ((vs (t:vs
              (t:mutant "--tag ghcr.io/pleme-io/tool:${{ github.ref_name }} \\\n"
                        "--tag ghcr.io/pleme-io/tool:${{ github.ref_name }} \\\n            --tag ghcr.io/pleme-io/tool:latest \\\n"))))
    (assert (t:has? vs "job `image-manifest`: names the `latest` tag") "manifest latest refused")))

(deftest "release-assets must wait for every publishing job"
  (let ((vs (t:vs (t:mutant "needs: [binary-tool, image-tool-amd64, image-manifest, chart]"
                            "needs: [binary-tool, image-tool-amd64, image-manifest]"))))
    (assert (t:has? vs "job `release-assets`: does not need `chart`") "the dropped leg is named")))

(deftest "release-assets runs only on a v* tag"
  (let ((vs (t:vs (t:mutant "    if: startsWith(github.ref, 'refs/tags/v')\n" ""))))
    (assert (t:has? vs "job `release-assets`: needs `if:") "tag guard required")))

(deftest "release-assets must run the verify step"
  (let ((vs (t:vs (t:mutant "RELEASE_CONTRACT_MODE: verify" "RELEASE_CONTRACT_MODE: check"))))
    (assert (t:has? vs "job `release-assets`: needs a step `id: verify`") "verify mode required")))

(deftest "promote-latest must wait for the check and the release, and move only what was checked"
  (let ((vs (t:vs (t:mutant "    needs: [release-assets, publish-release]\n" "    needs: [publish-release]\n"))))
    (assert (t:has? vs "job `promote-latest`: does not need `release-assets`") "promote waits for the check"))
  (let ((vs (t:vs (t:mutant "    needs: [release-assets, publish-release]\n" "    needs: [release-assets]\n"))))
    (assert (t:has? vs "job `promote-latest`: does not need `publish-release`") "promote waits for the GitHub Release"))
  (let ((vs (t:vs (t:mutant "${{ fromJSON(needs.release-assets.outputs.images) }}" "[ghcr.io/pleme-io/tool]"))))
    (assert (t:has? vs "job `promote-latest`: needs `strategy.matrix.image") "image list comes from the check")))

(deftest "a workflow without the gate jobs is refused"
  (let ((vs (t:vs (t:mutant "  release-assets:\n" "  release-assets-renamed:\n"))))
    (assert (t:has? vs "job `release-assets`: missing") "missing gate named")
    (assert (t:has? vs "job `release-assets-renamed`: publishes nothing the release contract knows")
      "an uncatalogued job is refused")))

(deftest "a new publishing job with no catalog row is refused"
  (let ((vs (t:vs
              (t:mutant "  release-assets:\n"
                        "  npm-publish:\n    runs-on: ubuntu-latest\n    steps:\n      - run: npm publish\n  release-assets:\n"))))
    (assert (t:has? vs "job `npm-publish`: publishes nothing the release contract knows") "unknown kind refused")
    (assert (t:has? vs "job `release-assets`: does not need `npm-publish`") "and it is not waited on")))

(deftest "per-arch images with no job joining them into :<tag> are refused"
  (let ((vs (t:vs (t:mutant "docker buildx imagetools create" "docker buildx imagetools inspect"))))
    (assert (t:has? vs "no job joins them into the `:<tag>` index") "the index promote-latest moves must exist")))

(deftest "verify reports exactly the assets that are missing"
  (let* ((assets (rc:expected-assets (t:wf t:GOOD) "v2.0.0"))
         (present-files (list "tool-linux-x86_64" "tool-linux-x86_64.sha256" "tool-macos-x86_64"
                              "tool-macos-x86_64.sha256" "tool-macos-aarch64" "tool-macos-aarch64.sha256"
                              "tool-linux-aarch64"))
         (present-refs (list "ghcr.io/pleme-io/tool:v2.0.0-amd64" "ghcr.io/pleme-io/tool:v2.0.0"))
         (missing (rc:missing-assets assets (fn (f) (member? f present-files)) (fn (r) (member? r present-refs)))))
    (assert (= (length assets) 11) "8 binary files, 1 arch image, 1 index, 1 chart")
    (assert (= (length missing) 2) "two missing")
    (assert (t:asset? missing "file" "tool-linux-aarch64.sha256") "the missing sidecar")
    (assert (t:asset? missing "oci" "ghcr.io/pleme-io/engenho/charts/engenho:2.0.0") "the missing chart"))
  (let ((assets (rc:expected-assets (t:wf t:GOOD) "v2.0.0")))
    (assert (= (length (rc:missing-assets assets (fn (f) true) (fn (r) true))) 0) "all present: nothing missing")
    (assert (= (length (rc:missing-assets assets (fn (f) false) (fn (r) false))) (length assets)) "none present: all missing")))

(deftest "verify refuses a binary that does not match its .sha256"
  (let* ((assets (rc:expected-assets (t:wf t:GOOD) "v2.0.0"))
         ;; Each binary's sum is its own name and each .sha256 names its
         ;; binary, except: macos-x86_64 has no readable sum, and
         ;; linux-aarch64's .sha256 names other bytes.
         (sum-of (fn (f) (if (equal? f "tool-macos-x86_64") "" f)))
         (sidecar-of (fn (s) (if (equal? s "tool-linux-aarch64.sha256") "tool-linux-x86_64" (string-replace s ".sha256" ""))))
         (bad (rc:bad-checksums assets sum-of sidecar-of)))
    (assert (= (length bad) 2) "two binaries fail")
    (assert (member? "tool-linux-aarch64" bad) "a .sha256 for other bytes")
    (assert (member? "tool-macos-x86_64" bad) "a binary with no readable sum")
    (assert (not (any? (fn (f) (string-ends-with? f ".sha256")) bad)) "checksum files are not themselves checked"))
  (let ((assets (rc:expected-assets (t:wf t:GOOD) "v2.0.0")))
    (assert (= (length (rc:bad-checksums assets (fn (f) f) (fn (s) (string-replace s ".sha256" "")))) 0)
      "every binary matches: nothing refused")
    (assert (= (length (rc:bad-checksums assets (fn (f) "x") (fn (s) "y"))) 4) "every binary differs: all four legs refused"))
  (assert (equal? (rc:first-field "abc123  tool-linux-x86_64\n") "abc123") "shasum's line: the hex field")
  (assert (equal? (rc:first-field "  \n") "") "an empty file has no sum"))

(deftest "matrix-include legs replace the built-in ones"
  (let* ((wf (t:mutant "      binary-name: tool\n"
                       "      binary-name: tool\n      matrix-include: '[{\"os\":\"ubuntu-latest\",\"target\":\"x86_64-unknown-linux-musl\",\"suffix\":\"linux-x86_64\"}]'\n"))
         (files (filter (fn (a) (equal? (car a) "file")) (rc:expected-assets wf "v1.0.0"))))
    (assert (= (length files) 2) "one leg: binary + sha256")
    (assert (t:asset? files "file" "tool-linux-x86_64.sha256") "the declared leg")))
