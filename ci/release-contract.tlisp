;; release-contract — `:latest` moves only after every release leg is green
;; and every asset the release promises exists.
;;
;; WHY (improvement plan T0.3a). Before this, release.yml moved `:latest`
;; before anything was checked, and from three places per image:
;;   * each of the four image-push.yml calls pushed `:latest` as well as its
;;     arch tag, because that reusable's `additionalTags` defaults to
;;     "latest". Nothing in release.yml said so; the default did it. The two
;;     arch legs of one image raced for the same tag, so for a while
;;     `:latest` was a single-arch image.
;;   * image-manifest then tagged the multi-arch index `:latest` too, in the
;;     same command that made `:<tag>`, without waiting on the binary legs or
;;     the chart.
;; A release whose aarch64 binaries or chart failed still moved `:latest`.
;;
;; THE CONTRACT, for .github/workflows/release.yml:
;;   * every job is one row of the catalog below (binary, image, manifest,
;;     chart, release-assets, promote-latest). A job that is none of them
;;     fails the check, because its assets would go unverified.
;;   * only promote-latest names the `latest` tag. Every image-push.yml call
;;     declares `tag` and `additionalTags: ''` explicitly, since both
;;     defaults push `latest`.
;;   * release-assets needs every publishing job, runs only on a `v*` tag,
;;     and runs this script in verify mode.
;;   * promote-latest needs release-assets and takes its image list from
;;     release-assets' output, so the images it moves are the ones that were
;;     checked.
;;
;; MODES (RELEASE_CONTRACT_MODE):
;;   check  (default) read release.yml and report contract violations. CI
;;          runs this on every push (test.yml, job release-contract).
;;   verify at release time: re-check the contract, derive every asset the
;;          release promises from release.yml, and look each one up: GitHub
;;          Release files with `gh release view`, OCI refs (images, the
;;          multi-arch indexes, the chart) with `docker buildx imagetools
;;          inspect --raw`. Writes `matrix` (a JSON list of the image repos to
;;          promote), `missing-count` and `verdict` to GITHUB_OUTPUT. Needs
;;          RELEASE_TAG, GITHUB_REPOSITORY and GH_TOKEN.
;;
;; TIER: a CI gate plus a release-time check, not a type. The check reads the
;; YAML the runner reads, so a removed `needs`, a new `latest`, or a new
;; publishing job with no row is caught before merge. It cannot see inside
;; the substrate reusables: if one starts pushing `latest` under a new input
;; name, this does not notice. The verify mode proves each asset EXISTS at
;; promotion time, not that it is correct.
;;
;; Exit codes: 0 clean · 1 a violation or a missing asset · 3 nothing was
;; examined (no release.yml, no jobs, or no asset to check): the check proved
;; nothing, which is not the same as finding nothing wrong.
;;
;; Tests: ci/release-contract.test.tlisp (tlisp-test sets TLISP_TEST=1, which
;; loads these definitions and skips the main at the bottom).

(define rc:WORKFLOW ".github/workflows/release.yml")
(define rc:ASSETS-JOB "release-assets")
(define rc:PROMOTE-JOB "promote-latest")
(define rc:SELF "ci/release-contract.tlisp")
(define rc:PROMOTE-MATRIX "${{ fromJSON(needs.release-assets.outputs.images) }}")

;; The built-in legs of substrate's rust-binary-release.yml (its matrix at
;; lines 175-179): gnu and musl builds use the same four suffixes. A caller
;; that passes `matrix-include` has its own suffixes read from that JSON.
(define rc:BINARY-LEGS (list "linux-x86_64" "linux-aarch64" "macos-x86_64" "macos-aarch64"))

;; `latest` as a tag: after `:`, whitespace, a quote or `=`, and before the
;; end, whitespace or a quote. `ubuntu-latest` (a runner label) does not match.
(define rc:LATEST-TAG "(^|[:\\s'\"=])latest($|[\\s'\"])")
(define rc:REF-NAME "\\$\\{\\{\\s*github\\.ref_name\\s*\\}\\}")
;; The tag the check mode derives asset names with.
(define rc:PROBE-TAG "v0.0.0-contract")

;; ── Reading the parsed workflow ──────────────────────────────────────────
;; yaml-parse yields a mapping as a list of (key value) lists.

(define (rc:get al key) (if (list? al) (alist-get al key "") ""))

(define (rc:has-key? al key)
  (and (list? al) (any? (fn (e) (and (list? e) (equal? (car e) key))) al)))

(define (rc:as-list v)
  (cond
    ((list? v) v)
    ((and (string? v) (not (equal? (string-trim v) ""))) (list v))
    (else (list))))

(define (rc:jobs wf) (rc:as-list (rc:get wf "jobs")))
(define (rc:job-names wf) (map car (rc:jobs wf)))
(define (rc:job wf name) (rc:get (rc:get wf "jobs") name))
(define (rc:with job) (rc:get job "with"))
(define (rc:steps job) (rc:as-list (rc:get job "steps")))
(define (rc:needs job) (rc:as-list (rc:get job "needs")))

;; Every string in a parsed value, keys included.
(define (rc:strings v)
  (cond
    ((string? v) (list v))
    ((list? v) (reduce (fn (acc x) (append acc (rc:strings x))) (list) v))
    (else (list))))

(define (rc:names-latest? v) (any? (fn (s) (re-match? rc:LATEST-TAG s)) (rc:strings v)))

(define (rc:subst-tag s tag) (re-replace rc:REF-NAME s tag))

(define (rc:strip-v tag) (if (string-starts-with? tag "v") (string-join "v" (cdr (string-split tag "v"))) tag))

(define (rc:strip-oci reg) (if (string-starts-with? reg "oci://") (string-replace reg "oci://" "") reg))

;; ── The catalog: what each job publishes ─────────────────────────────────

(define (rc:uses? job workflow-file) (string-contains? (rc:get job "uses") (string-append "/" workflow-file "@")))

(define (rc:joins-images? job)
  (any? (fn (st) (string-contains? (rc:get st "run") "imagetools create")) (rc:steps job)))

;; One of: binary image manifest chart assets promote unknown.
(define (rc:job-kind name job)
  (cond
    ((equal? name rc:ASSETS-JOB) "assets")
    ((equal? name rc:PROMOTE-JOB) "promote")
    ((rc:uses? job "rust-binary-release.yml") "binary")
    ((rc:uses? job "image-push.yml") "image")
    ((rc:uses? job "helm-chart-release.yml") "chart")
    ((rc:joins-images? job) "manifest")
    (else "unknown")))

(define (rc:kind-of wf name) (rc:job-kind name (rc:job wf name)))

(define (rc:names-of-kind wf kind) (filter (fn (n) (equal? (rc:kind-of wf n) kind)) (rc:job-names wf)))

(define (rc:publishing-jobs wf)
  (filter (fn (n) (not (member? (rc:kind-of wf n) (list "assets" "promote")))) (rc:job-names wf)))

(define (rc:binary-legs job)
  (let ((inc (rc:get (rc:with job) "matrix-include")))
    (if (and (string? inc) (not (equal? (string-trim inc) "")))
      (map (fn (o) (alist-get o "suffix" "")) (json-parse inc))
      rc:BINARY-LEGS)))

(define (rc:image-repo job)
  (let ((reg (rc:get (rc:with job) "registry")))
    (string-append (if (equal? reg "") "ghcr.io" reg) "/" (rc:get (rc:with job) "imageName"))))

(define (rc:image-repos wf) (distinct (map (fn (n) (rc:image-repo (rc:job wf n))) (rc:names-of-kind wf "image"))))

(define (rc:chart-name job)
  (let ((f (path-join (rc:get (rc:with job) "chart-path") "Chart.yaml")))
    (if (path-exists? f) (rc:get (yaml-parse (read-file f)) "name") "")))

;; An asset is (list "file" <GitHub Release file name>) or (list "oci" <ref>).
(define (rc:job-assets wf name tag)
  (let* ((job (rc:job wf name)) (w (rc:with job)) (kind (rc:job-kind name job)))
    (cond
      ((equal? kind "binary")
        (let ((bin (rc:get w "binary-name")))
          (reduce
            (fn (acc leg)
              (append acc
                (list (list "file" (string-append bin "-" leg))
                      (list "file" (string-append bin "-" leg ".sha256")))))
            (list)
            (rc:binary-legs job))))
      ((equal? kind "image")
        (list (list "oci" (string-append (rc:image-repo job) ":" (rc:subst-tag (rc:get w "tag") tag)))))
      ((equal? kind "manifest")
        (map (fn (repo) (list "oci" (string-append repo ":" tag))) (rc:image-repos wf)))
      ((equal? kind "chart")
        (list
          (list "oci"
            (string-append (rc:strip-oci (rc:get w "oci-registry")) "/" (rc:chart-name job) ":" (rc:strip-v tag)))))
      (else (list)))))

(define (rc:expected-assets wf tag)
  (reduce (fn (acc n) (append acc (rc:job-assets wf n tag))) (list) (rc:publishing-jobs wf)))

(define (rc:asset-label a) (string-append (car a) " " (car (cdr a))))

;; ── Check mode: the contract, as a list of violation lines ───────────────

(define (rc:job-violations wf name)
  (let* ((job (rc:job wf name)) (w (rc:with job)) (kind (rc:job-kind name job)) (at (string-append "job `" name "`: ")))
    (append
      (if (equal? kind "unknown")
        (list (string-append at "publishes nothing the release contract knows (binary, image, manifest, chart). Add its row to " rc:SELF " so its assets are checked before :latest moves"))
        (list))
      (if (and (not (equal? kind "promote")) (rc:names-latest? job))
        (list (string-append at "names the `latest` tag; only " rc:PROMOTE-JOB " may move it, after " rc:ASSETS-JOB))
        (list))
      (if (equal? kind "image")
        (append
          (if (not (string-contains? (rc:subst-tag (rc:get w "tag") rc:PROBE-TAG) rc:PROBE-TAG))
            (list (string-append at "image-push.yml needs `tag:` containing ${{ github.ref_name }}; its default tag is `latest`"))
            (list))
          (if (or (not (rc:has-key? w "additionalTags")) (not (equal? (string-trim (rc:get w "additionalTags")) "")))
            (list (string-append at "image-push.yml needs `additionalTags: ''`; its default pushes `latest` with every arch tag"))
            (list))
          (if (equal? (rc:get w "imageName") "")
            (list (string-append at "image-push.yml needs an explicit `imageName`, or the asset check cannot name the image"))
            (list)))
        (list))
      (if (and (equal? kind "binary") (equal? (rc:get w "binary-name") ""))
        (list (string-append at "rust-binary-release.yml needs `binary-name`"))
        (list))
      (if (and (equal? kind "chart") (equal? (rc:chart-name job) ""))
        (list (string-append at "no Chart.yaml with a `name` under chart-path `" (rc:get w "chart-path") "`"))
        (list))
      ;; Every derived asset name must be fully resolved, and must not be `latest`.
      (filter (fn (s) (not (equal? s "")))
        (map
          (fn (a)
            (let ((ref (car (cdr a))))
              (cond
                ((string-contains? ref "${{")
                  (string-append at "cannot derive an asset name from `" ref "`; only ${{ github.ref_name }} is understood"))
                ((string-ends-with? ref ":latest")
                  (string-append at "publishes `" ref "`"))
                (else ""))))
          (rc:job-assets wf name rc:PROBE-TAG))))))

(define (rc:assets-job-violations wf)
  (let* ((job (rc:job wf rc:ASSETS-JOB)) (at (string-append "job `" rc:ASSETS-JOB "`: ")) (needs (rc:needs job)))
    (if (not (rc:has-key? (rc:get wf "jobs") rc:ASSETS-JOB))
      (list (string-append at "missing; nothing checks that every asset exists before :latest moves"))
      (append
        (map (fn (n) (string-append at "does not need `" n "`, so :latest can move while that leg is red or still running"))
          (filter (fn (n) (not (member? n needs))) (rc:publishing-jobs wf)))
        (if (not (string-contains? (rc:get job "if") "refs/tags/v"))
          (list (string-append at "needs `if: startsWith(github.ref, 'refs/tags/v')`; a branch dispatch must never promote"))
          (list))
        (if (not (any? (fn (st) (and (equal? (rc:get st "id") "verify")
                                     (string-starts-with? (rc:get st "uses") "pleme-io/actions/tatara-script@")
                                     (equal? (rc:get (rc:get st "with") "script-file") rc:SELF)
                                     (equal? (rc:get (rc:get st "env") "RELEASE_CONTRACT_MODE") "verify")))
                       (rc:steps job)))
          (list (string-append at "needs a step `id: verify` running " rc:SELF " through pleme-io/actions/tatara-script with RELEASE_CONTRACT_MODE: verify"))
          (list))
        (if (not (equal? (rc:get (rc:get job "outputs") "images") "${{ steps.verify.outputs.matrix }}"))
          (list (string-append at "needs `outputs: images: ${{ steps.verify.outputs.matrix }}`, the list of images it checked"))
          (list))))))

(define (rc:promote-job-violations wf)
  (let* ((job (rc:job wf rc:PROMOTE-JOB)) (at (string-append "job `" rc:PROMOTE-JOB "`: ")))
    (if (not (rc:has-key? (rc:get wf "jobs") rc:PROMOTE-JOB))
      (list (string-append at "missing; nothing moves :latest after the release is checked"))
      (append
        (if (not (member? rc:ASSETS-JOB (rc:needs job)))
          (list (string-append at "does not need `" rc:ASSETS-JOB "`, so :latest can move before the assets are checked"))
          (list))
        (if (not (equal? (rc:get (rc:get (rc:get job "strategy") "matrix") "image") rc:PROMOTE-MATRIX))
          (list (string-append at "needs `strategy.matrix.image: " rc:PROMOTE-MATRIX "`, so it moves exactly the images that were checked"))
          (list))))))

(define (rc:violations wf)
  (append
    (reduce (fn (acc n) (append acc (rc:job-violations wf n))) (list) (rc:job-names wf))
    (if (and (not (equal? (rc:names-of-kind wf "image") (list))) (equal? (rc:names-of-kind wf "manifest") (list)))
      (list "images are pushed per arch, but no job joins them into the `:<tag>` index that promote-latest moves")
      (list))
    (rc:assets-job-violations wf)
    (rc:promote-job-violations wf)))

;; ── Verify mode: look every asset up ─────────────────────────────────────
;; The two presence checks are passed in, so the tests run this with fakes.
;; Returns the assets that are missing.
(define (rc:missing-assets assets file-present? oci-present?)
  (filter
    (fn (a) (not (if (equal? (car a) "file") (file-present? (car (cdr a))) (oci-present? (car (cdr a))))))
    assets))

(define (rc:release-files tag repo)
  (let ((r (exec-capture "gh" "release" "view" tag "--repo" repo "--json" "assets")))
    (if (= (alist-get r :status 1) 0)
      (map (fn (a) (alist-get a "name" "")) (alist-get (json-parse (alist-get r :stdout "")) "assets" (list)))
      (begin
        (print-line (string-append "gh release view " tag " failed: " (string-trim (alist-get r :stderr ""))))
        (list)))))

(define (rc:oci-exists? ref)
  (= (alist-get (exec-capture "docker" "buildx" "imagetools" "inspect" "--raw" ref) :status 1) 0))

(define (rc:output! line)
  (let ((path (env-get "GITHUB_OUTPUT" "")))
    (when (not (equal? path ""))
      (write-file path (string-append (if (path-exists? path) (read-file path) "") line "\n")))))

(define (rc:n x) (string-format "{}" x))

(define (rc:report-violations vs)
  (for-each (fn (v) (print-line (string-append "FAIL " rc:WORKFLOW " " v))) vs))

(define (rc:load)
  (if (path-exists? rc:WORKFLOW) (yaml-parse (read-file rc:WORKFLOW)) (list)))

(define (rc:check-main)
  (let* ((wf (rc:load)) (vs (rc:violations wf)) (assets (rc:expected-assets wf rc:PROBE-TAG)))
    (when (or (= (length (rc:job-names wf)) 0) (= (length assets) 0))
      (print-line (string-append "FATAL: " rc:WORKFLOW " has no job or no asset to check; the check proved nothing"))
      (exit 3))
    (rc:report-violations vs)
    (print-line
      (string-append "release contract: " (rc:n (length (rc:job-names wf))) " jobs · "
        (rc:n (length (rc:publishing-jobs wf))) " publishing · "
        (rc:n (length assets)) " assets per release · violations: " (rc:n (length vs))))
    (exit (if (> (length vs) 0) 1 0))))

(define (rc:verify-main)
  (let* ((tag (env-get "RELEASE_TAG" ""))
         (repo (env-get "GITHUB_REPOSITORY" ""))
         (wf (rc:load))
         (vs (rc:violations wf))
         (assets (rc:expected-assets wf tag)))
    (cond
      ((or (equal? tag "") (equal? repo ""))
        (print-line "FATAL: verify mode needs RELEASE_TAG and GITHUB_REPOSITORY")
        (rc:output! "verdict=no-input")
        (exit 3))
      ((> (length vs) 0)
        (rc:report-violations vs)
        (rc:output! "verdict=contract-broken")
        (exit 1))
      ((= (length assets) 0)
        (print-line (string-append "FATAL: " rc:WORKFLOW " promises no asset; nothing to verify"))
        (rc:output! "verdict=nothing-to-check")
        (exit 3))
      (else
        (let* ((files (rc:release-files tag repo))
               (missing (rc:missing-assets assets (fn (f) (member? f files)) rc:oci-exists?)))
          (for-each
            (fn (a) (print-line (string-append (if (member? a missing) "MISSING  " "present  ") (rc:asset-label a))))
            assets)
          (print-line
            (string-append "release " tag ": " (rc:n (length assets)) " assets expected · "
              (rc:n (- (length assets) (length missing))) " present · " (rc:n (length missing)) " missing"))
          (rc:output! (string-append "missing-count=" (rc:n (length missing))))
          (if (> (length missing) 0)
            (begin (rc:output! "verdict=missing") (exit 1))
            (begin
              (rc:output! "verdict=all-present")
              (rc:output! (string-append "matrix=" (json-stringify (rc:image-repos wf))))
              (exit 0))))))))

(cond
  ((equal? (env-get "TLISP_TEST" "") "1") (print-line "TLISP_TEST=1: release-contract loaded; main skipped"))
  ((equal? (env-get "RELEASE_CONTRACT_MODE" "check") "verify") (rc:verify-main))
  (else (rc:check-main)))
