[Unit]
After=network.target
Description=ESPHome dashboard

[Service]
Environment="LOCALE_ARCHIVE=/nix/store/49vhlwl9gib4vavpd64klpz4l5nwz3g5-glibc-locales-2.40-224/lib/locale/locale-archive"
Environment="PATH=/nix/store/42jyb458bsjkscbx6kp1xjz1pk7k75f1-esphome-2025.11.5/bin:/nix/store/hqkszxk2c0cxvd04xa4gsaqs182dw8l2-coreutils-9.8/bin:/nix/store/8xhaz2ysixijy8sgzmwmhlialqqind1p-findutils-4.10.0/bin:/nix/store/k3wiv3qqa4y0im5v1iq2jy4h9cm32dfc-gnugrep-3.12/bin:/nix/store/4zi0y6cmpjnbhmgrx7vfgqkyv5z1z4z0-gnused-4.9/bin:/nix/store/ckb44g2gn1ma5y47kh2bhk0zximhgqyi-systemd-258.7/bin:/nix/store/42jyb458bsjkscbx6kp1xjz1pk7k75f1-esphome-2025.11.5/sbin:/nix/store/hqkszxk2c0cxvd04xa4gsaqs182dw8l2-coreutils-9.8/sbin:/nix/store/8xhaz2ysixijy8sgzmwmhlialqqind1p-findutils-4.10.0/sbin:/nix/store/k3wiv3qqa4y0im5v1iq2jy4h9cm32dfc-gnugrep-3.12/sbin:/nix/store/4zi0y6cmpjnbhmgrx7vfgqkyv5z1z4z0-gnused-4.9/sbin:/nix/store/ckb44g2gn1ma5y47kh2bhk0zximhgqyi-systemd-258.7/sbin"
Environment="PLATFORMIO_CORE_DIR=/var/lib/esphome/.platformio"
Environment="TZDIR=/nix/store/qa63hibyghja8i40f907q9g97cvkdw8c-tzdata-2026b/share/zoneinfo"
CapabilityBoundingSet=
DeviceAllow=char-ttyS rw
DeviceAllow=char-ttyUSB rw
DevicePolicy=closed
DynamicUser=true
ExecStart=/nix/store/42jyb458bsjkscbx6kp1xjz1pk7k75f1-esphome-2025.11.5/bin/esphome dashboard --address localhost --port 6052 /var/lib/esphome
Group=esphome
LockPersonality=true
MemoryDenyWriteExecute=true
PrivateUsers=true
ProcSubset=all
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=false
ProtectKernelLogs=false
ProtectKernelModules=true
ProtectKernelTunables=false
ProtectProc=invisible
ProtectSystem=strict
Restart=on-failure
RestrictAddressFamilies=AF_INET
RestrictAddressFamilies=AF_INET6
RestrictAddressFamilies=AF_NETLINK
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=false
RestrictRealtime=true
RuntimeDirectoryMode=0750
StateDirectory=esphome
StateDirectoryMode=0750
SupplementaryGroups=dialout
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=@mount
UMask=0077
User=esphome
WorkingDirectory=/var/lib/esphome

[Install]
WantedBy=multi-user.target
