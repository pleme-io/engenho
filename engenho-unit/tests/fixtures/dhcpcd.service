[Unit]
After=resolvconf.service
Before=network-online.target
ConditionCapability=CAP_NET_ADMIN
Description=DHCP Client
Documentation=man:dhcpcd(8)
Wants=network.target resolvconf.service
X-Restart-Triggers=/nix/store/ynqa0iky3h5p8nbkgdy094zs8phzcnya-X-Restart-Triggers-dhcpcd

[Service]
Environment="LOCALE_ARCHIVE=/nix/store/0mk6nx5x3y5y7z7mkj4m6w9lkxw69zni-glibc-locales-2.40-224/lib/locale/locale-archive"
Environment="PATH=/nix/store/qbx04xfwv9i92436nhp3rn5wrhcwc6dz-dhcpcd-10.2.4/bin:/nix/store/rk2lsahnk4r7l0k7prayr3lki7g770v7-openresolv-3.17.0/bin:/nix/store/rqwprlka4q0f186yryjwpb1477i6k627-hostname/bin:/nix/store/nja3jimv61blss0mfgjqa68rfiwfxv39-coreutils-9.8/bin:/nix/store/f72alkaiwzx07151akyzlz0w7lwpi6px-findutils-4.10.0/bin:/nix/store/fpidzzfdfq4kqpg7izrjwl5dprm1ybql-gnugrep-3.12/bin:/nix/store/m4mnwm47q796m3zq16bpbca19r7ab2hk-gnused-4.9/bin:/nix/store/f99j50qvfy3lr4mxxad1qxsf7c6c9brj-systemd-258.7/bin:/nix/store/qbx04xfwv9i92436nhp3rn5wrhcwc6dz-dhcpcd-10.2.4/sbin:/nix/store/rk2lsahnk4r7l0k7prayr3lki7g770v7-openresolv-3.17.0/sbin:/nix/store/rqwprlka4q0f186yryjwpb1477i6k627-hostname/sbin:/nix/store/nja3jimv61blss0mfgjqa68rfiwfxv39-coreutils-9.8/sbin:/nix/store/f72alkaiwzx07151akyzlz0w7lwpi6px-findutils-4.10.0/sbin:/nix/store/fpidzzfdfq4kqpg7izrjwl5dprm1ybql-gnugrep-3.12/sbin:/nix/store/m4mnwm47q796m3zq16bpbca19r7ab2hk-gnused-4.9/sbin:/nix/store/f99j50qvfy3lr4mxxad1qxsf7c6c9brj-systemd-258.7/sbin"
Environment="TZDIR=/nix/store/61dk4kx1ra82nlzymqdxb8alpc0nn452-tzdata-2026b/share/zoneinfo"
X-StopIfChanged=false
AmbientCapabilities=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_RAW
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
DeviceAllow=
ExecReload=/nix/store/qbx04xfwv9i92436nhp3rn5wrhcwc6dz-dhcpcd-10.2.4/sbin/dhcpcd --rebind
ExecStart=@/nix/store/qbx04xfwv9i92436nhp3rn5wrhcwc6dz-dhcpcd-10.2.4/sbin/dhcpcd dhcpcd --quiet  --config /nix/store/vmkj4amljz4fxsf5831s2qg0p05bhlnn-dhcpcd.conf
ExecStartPre=+/nix/store/6lkpqc905a64jjb7rr426pdyjym8j8qr-migrate-dhcpcd
Group=dhcpcd
LockPersonality=true
MemoryDenyWriteExecute=true
NoNewPrivileges=true
PIDFile=/run/dhcpcd/pid
PrivateDevices=true
PrivateMounts=true
PrivateTmp=true
PrivateUsers=false
ProtectClock=true
ProtectControlGroups=true
ProtectHome=tmpfs
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
ReadWritePaths=/proc/sys/net/ipv4
ReadWritePaths=/proc/sys/net/ipv6
ReadWritePaths=/run/resolvconf
ReadWritePaths=/etc/resolv.conf
RemoveIPC=true
Restart=always
RestrictAddressFamilies=AF_UNIX
RestrictAddressFamilies=AF_INET
RestrictAddressFamilies=AF_INET6
RestrictAddressFamilies=AF_NETLINK
RestrictAddressFamilies=AF_PACKET
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RuntimeDirectory=dhcpcd
StateDirectory=dhcpcd
SupplementaryGroups=resolvconf
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@aio
SystemCallFilter=~@keyring
SystemCallFilter=~@memlock
SystemCallFilter=~@mount
SystemCallFilter=~@privileged
SystemCallFilter=~@resources
Type=forking
UMask=0027
User=dhcpcd

[Install]
WantedBy=multi-user.target network-online.target
