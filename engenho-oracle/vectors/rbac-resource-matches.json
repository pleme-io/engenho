     "note": "An impl that checks only HasPrefix(\"*/\") && HasSuffix(sub) would wrongly allow."},
    {"name": "*/subresource: suffix alone is not enough (trailing fragment)", "provenance": "upstream_code",
     "input": {"rule_resources": ["*/status"], "resource": "pods", "subresource": "tatus", "combined_requested_resource": "pods/tatus"},
     "expected": {"matches": false},
     "upstream_ref": "pkg/apis/rbac/v1/evaluation_helpers.go:ResourceMatches L69"},
    {"name": "*/subresource is case-sensitive", "provenance": "upstream_code",
     "input": {"rule_resources": ["*/Status"], "resource": "pods", "subresource": "status", "combined_requested_resource": "pods/status"},
     "expected": {"matches": false},
     "upstream_ref": "pkg/apis/rbac/v1/evaluation_helpers.go:ResourceMatches L71 (strings.HasSuffix is byte-exact)"},
    {"name": "exact match is case-sensitive", "provenance": "upstream_code",
     "input": {"rule_resources": ["pods"], "resource": "Pods", "subresource": "", "combined_requested_resource": "Pods"},
     "expected": {"matches": false},
     "upstream_ref": "pkg/apis/rbac/v1/evaluation_helpers.go:ResourceMatches L59 (==)"},
    {"name": "no glob: trailing * inside a name is literal", "provenance": "upstream_code",
