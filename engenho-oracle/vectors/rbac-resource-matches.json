     "expected": {"matches": false},
     "upstream_ref": "pkg/apis/rbac/helpers_test.go:TestResourceMatches[\"doesn't match on something else\"] L157"},

    {"name": "bare parent rule matches the bare parent", "provenance": "upstream_test",
     "input": {"rule_resources": ["pods"], "resource": "pods", "subresource": "", "combined_requested_resource": "pods"},
     "expected": {"matches": true},
     "upstream_ref": "plugin/pkg/auth/authorizer/rbac/rbac_test.go:TestAuthorizer case[2] shouldPass L228 (rule L222: verbs=*, apiGroups=*, resources=pods)"},
    {"name": "bare parent rule does NOT match a subresource (pods does not grant pods/status)", "provenance": "upstream_test",
     "input": {"rule_resources": ["pods"], "resource": "pods", "subresource": "status", "combined_requested_resource": "pods/status"},
     "expected": {"matches": false},
     "upstream_ref": "plugin/pkg/auth/authorizer/rbac/rbac_test.go:TestAuthorizer case[2] shouldFail L231 (rule L222)"},
    {"name": "role [pods/status, */scale]: pods/status allowed", "provenance": "upstream_test",
     "input": {"rule_resources": ["pods/status", "*/scale"], "resource": "pods", "subresource": "status", "combined_requested_resource": "pods/status"},
     "expected": {"matches": true},
     "upstream_ref": "plugin/pkg/auth/authorizer/rbac/rbac_test.go:TestAuthorizer case[3] shouldPass L246 (rules L238-239)",
