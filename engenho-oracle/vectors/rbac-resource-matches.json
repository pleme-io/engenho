     "expected": {"matches": true},
     "upstream_ref": "pkg/apis/rbac/helpers_test.go:TestResourceMatches[\"checks all rules\"] L89"},
    {"name": "exact resource/subresource rule matches that subresource", "provenance": "upstream_test",
     "input": {"rule_resources": ["foo/bar"], "resource": "foo", "subresource": "bar", "combined_requested_resource": "foo/bar"},
     "expected": {"matches": true},
     "upstream_ref": "pkg/apis/rbac/helpers_test.go:TestResourceMatches[\"matches exact rule\"] L95"},
    {"name": "subresource rule does NOT match its bare parent", "provenance": "upstream_test",
     "input": {"rule_resources": ["foo/bar"], "resource": "foo", "subresource": "", "combined_requested_resource": "foo"},
     "expected": {"matches": false},
     "upstream_ref": "pkg/apis/rbac/helpers_test.go:TestResourceMatches[\"matches exact rule 02\"] L102"},
    {"name": "*/subresource matches any parent with that subresource", "provenance": "upstream_test",
     "input": {"rule_resources": ["*/scale"], "resource": "foo", "subresource": "scale", "combined_requested_resource": "foo/scale"},
     "expected": {"matches": true},
     "upstream_ref": "pkg/apis/rbac/helpers_test.go:TestResourceMatches[\"matches subresource\"] L108"},
    {"name": "*/x does not match a subresource that merely starts with x/", "provenance": "upstream_test",
     "input": {"rule_resources": ["foo/bar", "*/other"], "resource": "foo", "subresource": "other/segment", "combined_requested_resource": "foo/other/segment"},
     "expected": {"matches": false},
     "upstream_ref": "pkg/apis/rbac/helpers_test.go:TestResourceMatches[\"doesn't match partial subresource hit\"] L115"},
    {"name": "*/sub matches a multi-slash subresource when the whole subresource string is equal", "provenance": "upstream_test",
     "input": {"rule_resources": ["*/other/segment"], "resource": "foo", "subresource": "other/segment", "combined_requested_resource": "foo/other/segment"},
     "expected": {"matches": true},
     "upstream_ref": "pkg/apis/rbac/helpers_test.go:TestResourceMatches[\"matches subresource with multiple slashes\"] L122"},
    {"name": "empty rule entry does not match a subresource request", "provenance": "upstream_test",
