     "upstream_ref": "pkg/apis/rbac/helpers_test.go:TestResourceMatches[\"doesn't fail on slash\"] L136"},
    {"name": "*/ with nothing after it is not a wildcard over all subresources", "provenance": "upstream_test",
     "input": {"rule_resources": ["*/"], "resource": "foo", "subresource": "other/segment", "combined_requested_resource": "foo/other/segment"},
     "expected": {"matches": false},
     "upstream_ref": "pkg/apis/rbac/helpers_test.go:TestResourceMatches[\"doesn't fail on missing subresource\"] L143"},
    {"name": "leading * glued to a word is not a wildcard", "provenance": "upstream_test",
