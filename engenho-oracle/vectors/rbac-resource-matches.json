     "upstream_ref": "pkg/apis/rbac/v1/evaluation_helpers.go:ResourceMatches L59"},
    {"name": "matching is on the joined string: a resource field that itself contains a slash matches a resource/sub rule", "provenance": "upstream_code",
     "input": {"rule_resources": ["pods/status"], "resource": "pods/status", "subresource": "", "combined_requested_resource": "pods/status"},
     "expected": {"matches": true},
     "upstream_ref": "plugin/pkg/auth/authorizer/rbac/rbac.go:RuleAllows L180-183 + pkg/apis/rbac/v1/evaluation_helpers.go:ResourceMatches L59",
     "note": "Not reachable from a URL (requestinfo.go L213-221 splits parts on /), but reachable via SubjectAccessReview spec.resourceAttributes.resource. A tuple-comparing impl (parse rule into (res,sub), compare to (resource,subresource)) returns false here."},
    {"name": "... but */sub does not match that same slash-bearing resource field (subresource is empty)", "provenance": "upstream_code",
