     "expected": {"matches": false},
     "upstream_ref": "pkg/apis/rbac/v1/evaluation_helpers.go:ResourceMatches L55, L59 (only exact \"*\" is special; unlike NonResourceURLMatches L102, no trailing-* prefix rule)"},
    {"name": "empty Resources list matches nothing", "provenance": "upstream_code",
