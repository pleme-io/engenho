    {"name": "star matches a subresource request too", "provenance": "upstream_code",
     "input": {"rule_resources": ["*"], "resource": "pods", "subresource": "status", "combined_requested_resource": "pods/status"},
     "expected": {"matches": true},
     "upstream_ref": "pkg/apis/rbac/v1/evaluation_helpers.go:ResourceMatches L55-57 (ruleResource == ResourceAll returns before any subresource logic)",
     "note": "A naive impl that treats * as 'any top-level resource' and requires */* or x/* for subresources gets this wrong."},
    {"name": "resource/* is NOT a subresource wildcard", "provenance": "upstream_code",
     "input": {"rule_resources": ["pods/*"], "resource": "pods", "subresource": "status", "combined_requested_resource": "pods/status"},
     "expected": {"matches": false},
     "upstream_ref": "pkg/apis/rbac/v1/evaluation_helpers.go:ResourceMatches L59 (\"pods/*\" != \"pods/status\") and L69-71 (no \"*/\" prefix)",
     "note": "Most surprising gap for a reimplementation: there is no parent/* form. To grant all pod subresources you must list each one, or use *."},
    {"name": "resource/* does not match its bare parent either", "provenance": "upstream_code",
     "input": {"rule_resources": ["pods/*"], "resource": "pods", "subresource": "", "combined_requested_resource": "pods"},
     "expected": {"matches": false},
     "upstream_ref": "pkg/apis/rbac/v1/evaluation_helpers.go:ResourceMatches L59, L65-67"},
    {"name": "resource/* matches only a subresource literally named *", "provenance": "upstream_code",
     "input": {"rule_resources": ["pods/*"], "resource": "pods", "subresource": "*", "combined_requested_resource": "pods/*"},
     "expected": {"matches": true},
     "upstream_ref": "pkg/apis/rbac/v1/evaluation_helpers.go:ResourceMatches L59 (plain string equality on the combined string)",
     "note": "Reachable via SubjectAccessReview (pkg/registry/authorization/util/helpers.go:ResourceAttributesFrom L44 copies Subresource verbatim) or a URL whose third part is a literal *."},
    {"name": "*/* is NOT 'every subresource of every resource'", "provenance": "upstream_code",
     "input": {"rule_resources": ["*/*"], "resource": "pods", "subresource": "status", "combined_requested_resource": "pods/status"},
     "expected": {"matches": false},
     "upstream_ref": "pkg/apis/rbac/v1/evaluation_helpers.go:ResourceMatches L69 (len(\"*/*\")=3 != len(\"status\")+2=8)"},
    {"name": "*/* matches only a subresource literally named *", "provenance": "upstream_code",
     "input": {"rule_resources": ["*/*"], "resource": "pods", "subresource": "*", "combined_requested_resource": "pods/*"},
     "expected": {"matches": true},
     "upstream_ref": "pkg/apis/rbac/v1/evaluation_helpers.go:ResourceMatches L69-71 (3 == 1+2, prefix \"*/\", suffix \"*\")"},
    {"name": "*/* does not match a bare resource", "provenance": "upstream_code",
     "input": {"rule_resources": ["*/*"], "resource": "pods", "subresource": "", "combined_requested_resource": "pods"},
     "expected": {"matches": false},
     "upstream_ref": "pkg/apis/rbac/v1/evaluation_helpers.go:ResourceMatches L65-67"},
    {"name": "*/subresource does not match a bare resource", "provenance": "upstream_code",
     "input": {"rule_resources": ["*/scale"], "resource": "deployments", "subresource": "", "combined_requested_resource": "deployments"},
     "expected": {"matches": false},
     "upstream_ref": "pkg/apis/rbac/v1/evaluation_helpers.go:ResourceMatches L65-67 (empty subresource skips the */ branch)"},
    {"name": "*/subresource: suffix alone is not enough, lengths must line up (short subresource)", "provenance": "upstream_code",
