  "function_under_test": "ResourceMatches(rule *PolicyRule, combinedRequestedResource, requestedSubresource string) bool",
  "input_contract": {
    "rule_resources": "PolicyRule.Resources, verbatim (order and duplicates irrelevant; each entry tested independently, first hit wins)",
    "resource": "authorizer.Attributes.GetResource()",
    "subresource": "authorizer.Attributes.GetSubresource()",
    "combined_requested_resource": "resource if subresource is empty, else resource + \"/\" + subresource (plugin/pkg/auth/authorizer/rbac/rbac.go:180-183). Always derivable from resource+subresource; carried explicitly because it is the actual first argument."
  },
  "provenance_legend": {
    "upstream_test": "the (input, expected) pair appears in an upstream Go test table at v1.34.0",
    "upstream_code": "expected value derived by reading ResourceMatches at v1.34.0; no upstream test pins it. Verified by executing the verbatim upstream function body (see .md)."
  },
  "cases": [
    {"name": "star matches plain resource", "provenance": "upstream_test",
     "input": {"rule_resources": ["*"], "resource": "foo", "subresource": "", "combined_requested_resource": "foo"},
     "expected": {"matches": true},
     "upstream_ref": "pkg/apis/rbac/helpers_test.go:TestResourceMatches[\"all matches 01\"] L83"},
    {"name": "star anywhere in the list matches (every entry is checked)", "provenance": "upstream_test",
