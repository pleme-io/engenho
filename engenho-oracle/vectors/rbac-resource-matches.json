    {"name": "role [pods/status, */scale]: pods/scale allowed via */scale", "provenance": "upstream_test",
     "input": {"rule_resources": ["pods/status", "*/scale"], "resource": "pods", "subresource": "scale", "combined_requested_resource": "pods/scale"},
     "expected": {"matches": true},
     "upstream_ref": "plugin/pkg/auth/authorizer/rbac/rbac_test.go:TestAuthorizer case[3] shouldPass L247"},
    {"name": "role [pods/status, */scale]: deployments/scale allowed via */scale", "provenance": "upstream_test",
     "input": {"rule_resources": ["pods/status", "*/scale"], "resource": "deployments", "subresource": "scale", "combined_requested_resource": "deployments/scale"},
