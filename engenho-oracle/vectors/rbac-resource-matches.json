     "upstream_ref": "plugin/pkg/auth/authorizer/rbac/rbac_test.go:TestAuthorizer case[3] shouldPass L248"},
    {"name": "role [pods/status, */scale]: an arbitrary parent's scale allowed", "provenance": "upstream_test",
     "input": {"rule_resources": ["pods/status", "*/scale"], "resource": "anything", "subresource": "scale", "combined_requested_resource": "anything/scale"},
     "expected": {"matches": true},
     "upstream_ref": "plugin/pkg/auth/authorizer/rbac/rbac_test.go:TestAuthorizer case[3] shouldPass L249"},
    {"name": "role [pods/status, */scale]: bare pods denied (neither subresource rule grants the parent)", "provenance": "upstream_test",
     "input": {"rule_resources": ["pods/status", "*/scale"], "resource": "pods", "subresource": "", "combined_requested_resource": "pods"},
     "expected": {"matches": false},
     "upstream_ref": "plugin/pkg/auth/authorizer/rbac/rbac_test.go:TestAuthorizer case[3] shouldFail L252"},
    {"name": "star matches a capitalised resource name (no normalisation needed for *)", "provenance": "upstream_test",
     "input": {"rule_resources": ["*"], "resource": "Pods", "subresource": "", "combined_requested_resource": "Pods"},
     "expected": {"matches": true},
     "upstream_ref": "plugin/pkg/auth/authorizer/rbac/rbac_test.go:TestAuthorizer case[0] shouldPass L165 (rule L159: newRule(\"*\",\"*\",\"*\",\"*\"))"},
    {"name": "star matches another arbitrary resource", "provenance": "upstream_test",
