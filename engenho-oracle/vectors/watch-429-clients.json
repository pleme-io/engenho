  "cases": [
    {
      "name": "classify_code_429_unknown_reason_is_too_many_requests",
      "client": "client-go",
      "input": {
        "status": {
          "code": 429,
          "reason": ""
        }
      },
      "expected": {
        "IsTooManyRequests": true,
        "IsGone": false,
        "IsResourceExpired": false,
        "IsInternalError": false
      },
      "upstream_ref": "apimachinery/pkg/api/errors/errors.go:IsTooManyRequests (L724)"
    },
    {
      "name": "classify_reason_too_many_requests_with_non_429_code",
      "client": "client-go",
      "input": {
        "status": {
          "code": 500,
          "reason": "TooManyRequests"
        }
      },
      "expected": {
        "IsTooManyRequests": true,
        "IsInternalError": false
      },
      "upstream_ref": "apimachinery/pkg/api/errors/errors.go:IsTooManyRequests + IsInternalError (code fallback only when reason is not in knownReasons)",
      "naive_trap": "matching on HTTP code alone would call this an internal error"
    },
    {
      "name": "classify_code_429_wins_even_with_known_other_reason",
      "client": "client-go",
      "input": {
        "status": {
          "code": 429,
          "reason": "Expired"
        }
      },
      "expected": {
        "IsTooManyRequests": true,
        "IsResourceExpired": true,
        "isExpiredError": true
      },
      "upstream_ref": "apimachinery/pkg/api/errors/errors.go:IsTooManyRequests comment 'does not check that the reason is unknown'",
      "naive_trap": "IsTooManyRequests is the ONLY Is* predicate whose code fallback ignores a known reason; both predicates are true at once"
    },
    {
