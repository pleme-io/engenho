      "upstream_ref": "apimachinery/pkg/api/errors/errors.go:IsGone (L573); client-go/tools/cache/reflector.go:isExpiredError (L1040)"
    },
    {
      "name": "classify_code_410_reason_expired_is_not_gone_but_is_expired",
      "client": "client-go",
      "input": {
        "status": {
          "code": 410,
          "reason": "Expired"
        }
      },
      "expected": {
