    {
      "name": "rest_watch_http_429_numeric_retry_after_retried_inside_rest_client",
      "client": "client-go",
      "input": {
        "http_responses": "every attempt: 429, header Retry-After: 2",
        "request_maxRetries": 10,
        "env_KUBE_CLIENT_BACKOFF": "unset"
      },
      "expected": {
        "http_attempts": 11,
        "sleep_before_each_retry_s": 2,
        "client_side_rate_limiter_consulted_before_first_attempt": false,
        "error_surfaced_to_reflector": {
          "code": 429,
          "IsTooManyRequests": true
        },
        "reflector_action": "backoffManager.Backoff() then re-watch at LastSyncResourceVersion; no LIST",
        "client_side_rate_limiter_consulted_before_each_retry": "yes, when the client has one (r.rateLimiter != nil, e.g. rest.Config QPS)"
      },
      "upstream_ref": "client-go/rest/request.go:Watch (L758-829), NewRequest maxRetries:10 (L166); rest/with_retry.go:IsNextRetry (L148-193), Before (L195-236), checkWait (L309); rest/client.go:readExpBackoffConfig -> NoBackoff",
      "naive_trap": "the reflector never sees the first 10 429s; the server hint is honoured at the HTTP layer, not by the reflector backoff"
    },
    {
      "name": "rest_watch_http_429_without_retry_after_not_retried",
      "client": "client-go",
      "input": {
        "http_responses": [
          "429 (no Retry-After)"
        ]
      },
      "expected": {
        "http_attempts": 1,
        "error_surfaced_to_reflector": {
          "code": 429
        },
        "reflector_action": "backoff, re-watch, no LIST"
      },
      "upstream_ref": "client-go/rest/with_retry.go:checkWait (returns false when header missing); reflector.go:watch L527-538 isWatchErrorRetriable"
    },
    {
      "name": "rest_watch_http_429_http_date_retry_after_not_retried",
      "client": "client-go",
      "input": {
        "http_responses": [
          "429, Retry-After: Wed, 21 Oct 2015 07:28:00 GMT"
        ]
      },
      "expected": {
        "http_attempts": 1,
        "details.retryAfterSeconds": 0
      },
      "upstream_ref": "client-go/rest/request.go:retryAfterSeconds (strconv.Atoi only, L1378)",
      "naive_trap": "RFC 9110 allows an HTTP-date Retry-After; client-go silently ignores it"
    },
    {
      "name": "rest_watch_retry_after_zero_and_negative",
      "client": "client-go",
      "input": {
        "http_responses": [
          "429, Retry-After: 0",
          "429, Retry-After: -1"
        ]
      },
      "expected": {
        "retried": true,
        "sleep_s": 0
