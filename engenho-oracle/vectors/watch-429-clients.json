      "upstream_ref": "client-go/rest/request.go:retryAfterSeconds (Atoi accepts '0' and '-1'); rest/urlbackoff.go:NoBackoff.SleepWithContext"
    },
    {
      "name": "rest_watch_5xx_with_retry_after_retried_410_is_not",
      "client": "client-go",
      "input": {
        "http_responses": [
          "504, Retry-After: 1",
          "503, Retry-After: 1",
          "500, Retry-After: 1",
          "410, Retry-After: 1"
        ]
      },
      "expected": {
        "504": "retried",
        "503": "retried",
        "500": "retried",
        "410": "not retried; error surfaced immediately"
      },
      "upstream_ref": "client-go/rest/with_retry.go:checkWait ('any 500 error code and 429 can trigger a wait')"
    },
    {
      "name": "rest_watch_body_status_overrides_http_code",
      "client": "client-go",
      "input": {
        "http_status": 429,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "kind": "Status",
          "apiVersion": "v1",
          "status": "Failure",
          "code": 410,
          "reason": "Expired"
        }
      },
      "expected": {
        "returned_error": {
          "code": 410,
          "reason": "Expired"
        },
        "IsTooManyRequests": false,
        "reflector_action": "Watch returns err -> ListAndWatch returns err -> DefaultWatchErrorHandler (isExpiredError, V(4)) -> backoff -> LIST"
      },
      "upstream_ref": "client-go/rest/request.go:Result.Error (L1489, decodes body Status when cause is UnexpectedServerResponse); reflector.go:isWatchErrorRetriable (L1081)",
      "naive_trap": "the decoded body Status replaces the synthesized error, so the HTTP code no longer decides the branch"
    },
    {
      "name": "rest_watch_body_status_not_failure_keeps_http_code",
