              "kind": "Pod"
            }
          }
        ]
      },
      "expected": {
        "error_type": "UnexpectedObjectError",
        "reflector_branch": "default (log 'Warning: watch ended with error')",
        "next_action": "return nil from watch(); backoff; relist"
      },
      "upstream_ref": "apimachinery/pkg/api/errors/errors.go:FromObject (L123); reflector.go:handleAnyWatch L901-902, watch() L567-571"
    },
    {
      "name": "inband_error_unstructured_status_wrong_apiversion",
      "client": "client-go",
      "input": {
