      "upstream_ref": "apimachinery/pkg/api/errors/errors.go:IsGone ('Expired' is a known reason so code fallback is skipped); reflector.go:isExpiredError"
    },
    {
      "name": "classify_code_410_with_known_non_gone_reason_is_not_expired",
      "client": "client-go",
      "input": {
        "status": {
          "code": 410,
          "reason": "TooManyRequests"
        }
      },
      "expected": {
        "IsGone": false,
        "IsResourceExpired": false,
        "isExpiredError": false,
        "IsTooManyRequests": true
      },
      "upstream_ref": "apimachinery/pkg/api/errors/errors.go:IsGone/IsResourceExpired/IsTooManyRequests",
      "naive_trap": "a code-410 => relist rule relists here; client-go backs off and re-watches instead"
    },
