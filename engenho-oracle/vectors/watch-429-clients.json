    {
      "name": "generic_http_error_mapping_non_status_body",
      "client": "client-go",
      "input": {
        "http_status_codes": [
          410,
          429,
          500,
          502,
          503,
          504
        ],
        "body": "non-Status text"
      },
      "expected": {
        "410": {
          "reason": "",
          "IsGone": true
        },
        "429": {
          "reason": "TooManyRequests",
          "IsTooManyRequests": true
        },
        "500": {
          "reason": "InternalError",
          "IsInternalError": true
        },
        "502": {
          "reason": "InternalError",
          "IsInternalError": true
        },
        "503": {
          "reason": "ServiceUnavailable"
        },
        "504": {
          "reason": "Timeout",
          "IsTimeout": true
        },
        "all": {
          "details.causes[0].type": "UnexpectedServerResponse",
          "details.retryAfterSeconds": "value of numeric Retry-After header, else 0"
        }
      },
      "upstream_ref": "apimachinery/pkg/api/errors/errors.go:NewGenericServerResponse (L436); client-go/rest/request.go:newUnstructuredResponseError"
    },
    {
